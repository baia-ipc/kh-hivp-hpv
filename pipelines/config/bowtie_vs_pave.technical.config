params {
  conda_env = "${projectDir}/../pipelines/conda_env/bowtie_vs_pave.env.yml"
  scripts_dir = "${projectDir}/../scripts"
  multiqc_config = "${projectDir}/../pipelines/multiqc/bowtie_vs_pave.multiqc.yml"
  bucket_tid = 151340
  pave_ref_fasta = "${projectDir}/../refdata/raw/pave/pave_hsa.fas"
  pave_gff3_dir = "${projectDir}/../refdata/raw/pave/gff3"
  pave_bed_dir = "${projectDir}/../refdata/raw/pave/bed"
  features_tsv_dir = "${projectDir}/../refdata/derived/pave/features_tsv"
  lineage_hpv16_fasta = "${projectDir}/../refdata/derived/hpv16_tree/lineages_ref_renamed.fasta"
  lineage_hpv18_fasta = "${projectDir}/../refdata/derived/hpv18_tree/lineages_ref_renamed.fasta"
}

process {
  cpus = params.threads
}
