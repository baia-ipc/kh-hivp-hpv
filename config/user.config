params {
  // Global defaults (shared across pipelines)
  threads = 24

  // Centrifuge bucketing
  reads = null
  index = "/srv/databases/centrifuge/hpvc/latest/hpvc"
  taxdump = "/srv/databases/centrifuge/hpvc/latest/factory/taxonomy-2023-10-30"
  homo_sapiens_tid = 9606
  skip_align = false
  aggregate_skip = "2886930,2759"

  // Bowtie vs PAVE mapping
  lineage_ref_hpv16_name = "HPV16REF|lcl|Human"
  lineage_ref_hpv18_name = "HPV18REF|lcl|Human"

  // Targeted analysis: country SNP comparison
  target_country = "Cambodia"

  // Targeted analysis: phylogenetic trees
  mafft_args = "--localpair --maxiterate 1000"
  trimal_gt = 0.90
  trimal_st = 0.01
  iqtree_model = "MFP"
  iqtree_outgroups = null
  iqtree_threads = "AUTO"
  iqtree_bootstrap = 1000
  iqtree_alrt = 1000

  // Recombination analysis
  recombination_input_mode = "metadata_fasta"
  recombination_hpv_types = null
  recombination_skip_controls = true
  recombination_control_pattern = '^(H2O|HPV-110|Ex|HPV-19|Undetermined.*)$'
  recombination_input_is_aligned = false
  recombination_min_sequences = 3
  recombination_mafft_args = "--auto"
  recombination_gard_model = "012345"
  recombination_gard_rate_classes = 3
  recombination_gard_max_breakpoints = 10
  recombination_gard_confidence = "low"
  recombination_enable_similarity_plot = true
}
