params {
  // Global defaults (shared across pipelines)
  threads = 24

  // Centrifuge bucketing
  reads = null
  index = "/srv/databases/centrifuge/hpvc/latest/hpvc"
  taxdump = "/srv/databases/centrifuge/hpvc/latest/factory/taxonomy-2023-10-30"
  homo_sapiens_tid = 9606
  skip_align = false
  aggregate_skip = "2886930,2759"

  // Bowtie vs PAVE mapping
  lineage_ref_hpv16_name = "HPV16REF|lcl|Human"
  lineage_ref_hpv18_name = "HPV18REF|lcl|Human"

  // Targeted analysis: country SNP comparison
  target_country = "Cambodia"

  // Targeted analysis: phylogenetic trees
  mafft_args = "--localpair --maxiterate 1000"
  trimal_gt = 0.90
  trimal_st = 0.01
  iqtree_model = "MFP"
  iqtree_outgroups = null
  iqtree_threads = "AUTO"
  iqtree_bootstrap = 1000
  iqtree_alrt = 1000
}
