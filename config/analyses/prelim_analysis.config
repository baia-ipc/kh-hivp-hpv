profiles {
  preliminary_centrifuge {
    params {
      samples_tsv = "${projectDir}/../metadata/samples-input1.tsv"
      outdir = "${projectDir}/../prelim_analysis/01.centrifuge/output"
      reports_dir = "${projectDir}/../prelim_analysis/01.centrifuge/reports"
    }
  }

  preliminary_bowtie_vs_pave {
    params {
      reads_dir = "${projectDir}/../prelim_analysis/01.centrifuge/output"
      outdir = "${projectDir}/../prelim_analysis/02.bowtie_vs_pave/output"
      reports_dir = "${projectDir}/../prelim_analysis/02.bowtie_vs_pave/reports"
      index_dir = "${projectDir}/../derived_data/indices/bowtie_vs_pave"
    }
  }

  preliminary_virstrain {
    params {
      reads_dir = "${projectDir}/../prelim_analysis/01.centrifuge/output"
      outdir = "${projectDir}/../prelim_analysis/05.virstrain/output"
      reports_dir = "${projectDir}/../prelim_analysis/05.virstrain/reports"
      index_dir = "${projectDir}/../derived_data/indices/preliminary/virstrain"
    }
  }

  preliminary_pave_e6 {
    params {
      reads_dir = "${projectDir}/../prelim_analysis/01.centrifuge/output"
      outdir = "${projectDir}/../prelim_analysis/03.bowtie_vs_pave.E6/output"
      reports_dir = "${projectDir}/../prelim_analysis/03.bowtie_vs_pave.E6/reports"
      index_dir = "${projectDir}/../derived_data/indices/preliminary/pave_e6"
      ref_fasta = "${projectDir}/../refdata/pave/pave_hsa.E6.fa"
      index_prefix = "pave_hsa.E6"
    }
  }

  preliminary_pave_e7 {
    params {
      reads_dir = "${projectDir}/../prelim_analysis/01.centrifuge/output"
      outdir = "${projectDir}/../prelim_analysis/04.bowtie_vs_pave.E7/output"
      reports_dir = "${projectDir}/../prelim_analysis/04.bowtie_vs_pave.E7/reports"
      index_dir = "${projectDir}/../derived_data/indices/preliminary/pave_e7"
      ref_fasta = "${projectDir}/../refdata/pave/pave_hsa.E7.fa"
      index_prefix = "pave_hsa.E7"
    }
  }
}
