profiles {
  targeted_bucketing {
    params {
      analysis_name = "targeted_analysis"
      step_name = "01.bucketing"
      samples_tsv = "${projectDir}/../metadata/seq_samples/samples_targeted_analysis.tsv"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_mapping_vs_pave {
    params {
      analysis_name = "targeted_analysis"
      step_name = "02.mapping_vs_pave"
      input_step_name = "01.bucketing"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_variant_analysis {
    params {
      analysis_name = "targeted_analysis"
      step_name = "03.variant_analysis"
      input_step_name = "02.mapping_vs_pave"
      samples_tsv = "${projectDir}/../metadata/seq_samples/samples_targeted_analysis.tsv"
      include_database = true
      multiqc_config = "${projectDir}/../pipelines/multiqc/variant_analysis_db.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_hpv16_tree {
    params {
      analysis_name = "targeted_analysis"
      step_name = "04.hpv16_tree"
      input_step_name = "02.mapping_vs_pave"
      outgroups_file = "${projectDir}/../metadata/hpv16_tree/hpv16_tree_outgroups.txt"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_hpv18_tree {
    params {
      analysis_name = "targeted_analysis"
      step_name = "05.hpv18_tree"
      input_step_name = "02.mapping_vs_pave"
      outgroups_file = "${projectDir}/../metadata/hpv18_tree/hpv18_tree_outgroups.txt"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_recombination_screen {
    params {
      analysis_name = "targeted_analysis"
      step_name = "06.recombination_screen"
      input_step_name = "03.variant_analysis"
      recombination_stage = "screen"
      recombination_sequences_tsv = "${projectDir}/../metadata/recombination_analysis/sequence_sets/targeted_analysis.recombination_sequences.tsv"
      recombination_exclude_samples_tsv = "${projectDir}/../metadata/recombination_analysis/exclude_lists/default_controls.txt"
      multiqc_config = "${projectDir}/../pipelines/multiqc/recombination_screen.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_recombination_openrdp {
    params {
      analysis_name = "targeted_analysis"
      step_name = "07.recombination_openrdp"
      input_step_name = "06.recombination_screen"
      recombination_stage = "openrdp"
      recombination_screen_groups_tsv = "${projectDir}/../outs/targeted_analysis/06.recombination_screen/summary/recombination_screen_groups.tsv"
      multiqc_config = "${projectDir}/../pipelines/multiqc/recombination_openrdp.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_recombination_3seq {
    params {
      analysis_name = "targeted_analysis"
      step_name = "07.recombination_3seq"
      input_step_name = "06.recombination_screen"
      recombination_stage = "3seq"
      recombination_screen_groups_tsv = "${projectDir}/../outs/targeted_analysis/06.recombination_screen/summary/recombination_screen_groups.tsv"
      multiqc_config = "${projectDir}/../pipelines/multiqc/recombination_3seq.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_recombination_geneconv {
    params {
      analysis_name = "targeted_analysis"
      step_name = "07.recombination_geneconv"
      input_step_name = "06.recombination_screen"
      recombination_stage = "geneconv"
      recombination_screen_groups_tsv = "${projectDir}/../outs/targeted_analysis/06.recombination_screen/summary/recombination_screen_groups.tsv"
      multiqc_config = "${projectDir}/../pipelines/multiqc/recombination_geneconv.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

  targeted_recombination_confirmation {
    params {
      analysis_name = "targeted_analysis"
      step_name = "08.recombination_confirmation"
      input_step_name = "07.recombination_openrdp"
      recombination_stage = "confirmation"
      recombination_openrdp_groups_tsv = "${projectDir}/../outs/targeted_analysis/07.recombination_openrdp/summary/recombination_openrdp_groups.tsv"
      multiqc_config = "${projectDir}/../pipelines/multiqc/recombination_confirmation.multiqc.yml"
      multiqc_outdir = "${projectDir}/../results/reports/targeted_analysis"
    }
  }

}
