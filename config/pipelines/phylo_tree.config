params {
  conda_env = "${projectDir}/../pipelines/conda_env/pipeline.env.yml"
  multiqc_config = "${projectDir}/../pipelines/multiqc/phylo_tree.multiqc.yml"
  // Sample selection / consensus quality thresholds.
  // Only include samples whose genome-wide breadth for the strain is at least
  // this fraction; mask consensus positions below this depth with N.
  min_cov_breadth = 0.9
  min_consensus_depth = 10
}
