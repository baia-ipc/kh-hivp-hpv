params {
  input_dir = "${projectDir}/../derived_data/refdata/hpv18_tree"
  refdata_dir = "${projectDir}/../refdata/hpv18_tree"
  derived_dir = "${projectDir}/../derived_data/refdata/hpv18_tree"
  lineages_tsv = "${projectDir}/../refdata/hpv18_tree/HPV18_lineages.tsv"
  ncbi_tsv = "${projectDir}/../refdata/hpv18_tree/HPV18-NCBIVirus.tsv"
  ncbi_fasta = "${projectDir}/../refdata/hpv18_tree/HPV18-NCBIVirus.fasta"
  acc_country_tsv = "${projectDir}/../derived_data/refdata/hpv18_tree/HPV18-NCBIVirus.acc_country.tsv"
  selected_tsv = "${projectDir}/../derived_data/refdata/hpv18_tree/HPV18-NCBIVirus.acc_country.selected.tsv"
  selection_list = "${projectDir}/../metadata/hpv18_tree_db_selection.txt"
  selection_columns = "1,10,11"
  outgroups_list = "${projectDir}/../metadata/hpv18_tree_outgroups.txt"
  samples_tsv = "${projectDir}/../metadata/samples-input2.tsv"
  mapping_outdir = "${projectDir}/../outs/targeted_analysis/02.mapping_vs_pave"
  strains_tsv = "${projectDir}/../outs/targeted_analysis/02.mapping_vs_pave/reports/strains.tsv"
  sample_prep_script = "${projectDir}/../scripts/phylo_tree/hpv18_prepare_samples.sh"
  lineage_extract_script = "${projectDir}/../scripts/phylo_tree/hpv18_extract_lineages_fasta.sh"
  selection_kind = "hpv18"
}
