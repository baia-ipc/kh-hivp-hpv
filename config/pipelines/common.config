conda {
  enabled = true
  cacheDir = "${projectDir}/../.conda"
}

process.executor = "local"
process.maxForks = 24
executor.queueSize = 24

params.multiqc_outdir = params.multiqc_outdir ?: "${projectDir}/../results/reports/unknown_analysis"
params.bowtie_index_dir = params.bowtie_index_dir ?: "${projectDir}/../derived_data/indices/bowtie_vs_pave"
params.conda_env = params.conda_env ?: "${projectDir}/../.conda/envs/pipeline"
