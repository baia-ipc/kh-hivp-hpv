params {
  reads_dir = null
  outdir = null
  reports_dir = null
  index_dir = null
  scripts_dir = "${projectDir}/../scripts"
  bucket_tid = null
  bucket_tid_file = "${projectDir}/../metadata/pave_bucket_tid.txt"
  ref_fasta = "${projectDir}/../refdata/pave/pave_hsa.E7.fa"
  index_prefix = "pave_hsa.E7"
  threads = 4
  conda_env = "${projectDir}/../config/pave_gene_mapping.env.yml"
}

conda {
  enabled = true
}

process {
  executor = "local"
  cpus = params.threads
  maxForks = 32
  conda = params.conda_env
}

executor {
  queueSize = 32
}
