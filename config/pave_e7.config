params {
  read1 = null
  read2 = null
  run_id = null
  sample_id = null
  reads_dir = null
  outdir = null
  reports_dir = null
  index_dir = null
  scripts_dir = "${projectDir}/../scripts"
  bucket_tid = null
  bucket_tid_file = "${projectDir}/../config/pave_bucket_tid.txt"
  multiqc_config = "${projectDir}/../config/pave_gene_mapping.multiqc.yml"
  ref_fasta = "${projectDir}/../refdata/raw/pave/pave_hsa.E7.fa"
  index_prefix = "pave_hsa.E7"
  threads = 24
  conda_env = "${projectDir}/../pipelines/conda_env/pave_gene_mapping.env.yml"
}

conda {
  enabled = true
}

process {
  executor = "local"
  cpus = params.threads
  maxForks = 24
  conda = params.conda_env
}

executor {
  queueSize = 24
}
