params {
  reads_dir = null
  outdir = null
  reports_dir = null
  index_dir = null
  scripts_dir = "${projectDir}/../scripts"
  bucket_tid = null
  bucket_tid_file = "${projectDir}/../metadata/pave_bucket_tid.txt"
  pave_ref_fasta = "/srv/virology/databases/pave/20240830/host_hsa/genome_fas/pave_hsa.fas"
  features_tsv_dir = "/srv/virology/databases/pave/20240830/host_hsa/features_tsv"
  pave_bed_dir = "/srv/virology/databases/pave/20240830/host_hsa/bed"
  threads = 24
  conda_env = "${projectDir}/../config/bowtie_vs_pave.env.yml"
}

conda {
  enabled = true
}

process {
  executor = "local"
  cpus = params.threads
  maxForks = 24
  conda = params.conda_env
}

executor {
  queueSize = 24
}
